# Local analyst authentication. No default username/password is provided.
FIN_SENTINELS_USERNAME=
FIN_SENTINELS_PASSWORD=
# Generate a random value of at least 32 characters and keep it private.
FIN_SENTINELS_SESSION_SECRET=

# Server-only key shared with backend.local.env; never prefix this with NEXT_PUBLIC_.
FIN_SENTINELS_BACKEND_API_KEY=

# Next.js proxies /api requests to this local FastAPI service.
FIN_API_INTERNAL_URL=http://127.0.0.1:8000

# Optional public API URL for direct evidence uploads that bypass the Next.js proxy.
FIN_API_PUBLIC_URL=
NEXT_PUBLIC_FIN_DIRECT_UPLOAD=false

# Server-only, random 32+ character secret shared with the FastAPI service.
FIN_SENTINELS_UPLOAD_SECRET=
