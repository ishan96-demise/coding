# Copy to .env and set unique production values before starting the stack.
FIN_SENTINELS_USERNAME=
FIN_SENTINELS_PASSWORD=
FIN_SENTINELS_SESSION_SECRET=
FIN_SENTINELS_BACKEND_API_KEY=
FINSENTINELS_DATA_MODE=production

# Keep bound to localhost behind a TLS reverse proxy on a single host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
PUBLIC_APP_URL=http://localhost:3000/
FIN_SENTINELS_COOKIE_SECURE=false

# Optional OBP configuration. Credentials are issued by your bank/sandbox.
OBP_API_BASE_URL=https://apisandbox.openbankproject.com
OBP_API_VERSION=v5.1.0
OBP_ACCESS_TOKEN=
OBP_BANK_ID=
OBP_VIEW_ID=
OBP_ACCOUNT_IDS=
OBP_WEBHOOK_SECRET=
OBP_WEBHOOK_SIGNATURE_HEADER=x-sandbox-signature
OBP_DEFAULT_CURRENCY=
FIN_SENTINELS_BASE_CURRENCY=INR
OBP_SYNC_PAGE_SIZE=100
OBP_SYNC_MAX_PAGES=10
