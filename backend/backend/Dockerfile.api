FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    FINSENTINELS_RUNTIME_DIR=/var/lib/finsentinels \
    FINSENTINELS_DATA_MODE=production

WORKDIR /app

COPY requirements-runtime.txt ./requirements-runtime.txt
RUN python -m pip install --no-cache-dir -r requirements-runtime.txt

COPY --chown=10001:10001 main.py graph_builder.py ml_engine.py obp_integration.py portal_store.py ./
COPY --chown=10001:10001 data ./data
COPY --chown=10001:10001 static ./static
RUN mkdir -p /var/lib/finsentinels && chown -R 10001:10001 /var/lib/finsentinels

USER 10001:10001
EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
