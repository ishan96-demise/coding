# Generate a random value of at least 32 characters and use the same value in
# frontend/.env.local as FIN_SENTINELS_BACKEND_API_KEY.
FIN_SENTINELS_BACKEND_API_KEY=
FIN_SENTINELS_FRONTEND_URL=http://127.0.0.1:3000/
FIN_SENTINELS_ALLOWED_ORIGINS=http://127.0.0.1:3000
# Set the same random 32+ character value in the Next.js environment for
# short-lived, case-scoped direct evidence upload authorization.
FIN_SENTINELS_UPLOAD_SECRET=
